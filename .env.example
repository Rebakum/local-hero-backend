PORT=5001
DATABASE_URL="postgresql://postgres:password@localhost:5432/localhero_db?schema=public"
CLIENT_URL="http://localhost:3000"
JWT_SECRET="change-this-to-a-long-random-string"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# Get these from your Cloudinary dashboard: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Get these from your Stripe dashboard: https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY starts with sk_test_... (test mode) or sk_live_...
STRIPE_SECRET_KEY=
# Stripe webhook signing secret. Created under Developers -> Webhooks after you add the /api/v1/payments/webhook endpoint
STRIPE_WEBHOOK_SECRET=

# Credentials for the auto-created Super Admin account (seeded on server start)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
