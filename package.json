{
  "name": "localhero-backend",
  "version": "1.0.0",
  "description": "LocalHero Backend API - Express + TypeScript + Prisma + Zod",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc --skipLibCheck",
    "vercel-build": "prisma generate && tsc --skipLibCheck",
    "start": "node dist/server.js",
    "db:migrate": "npx prisma migrate dev",
    "db:studio": "npx prisma studio",
    "db:generate": "npx prisma generate",
    "db:seed": "npx ts-node prisma/seed.ts",
    "db:cleanup-orphans": "ts-node prisma/cleanup-orphan-users.ts"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "@prisma/adapter-pg": "^6.19.3",
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "socket.io": "^4.8.3",
    "stripe": "^17.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@prisma/client": "6.19.3",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "prisma": "6.19.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true,
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
