
model Notification {
  id        String           @id @default(uuid())

  userId    String

  type      NotificationType @default(GENERAL)

  title     String
  body      String?

  data      Json?

  isRead    Boolean          @default(false)

  createdAt DateTime         @default(now())

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}
