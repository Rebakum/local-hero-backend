
model Faq {
  id        String   @id @default(uuid())

  question  String
  answer    String

  category  String?

  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}
