

// One-time "Featured Business" add-on purchases (top-of-search placement for
// a fixed number of days), per the product blueprint: 7 / 30 / 90 days.
model FeaturedAddon {
  id            String   @id @default(uuid())

  durationDays  Int
  priceInPence  Int

  active        Boolean  @default(true)
  sortOrder     Int      @default(0)

  // One-time Stripe price (created lazily and cached on first purchase).
  stripePriceId String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active])
}
