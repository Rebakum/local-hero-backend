PORT=5001
DATABASE_URL="postgresql://postgres:password@localhost:5432/localhero_db?schema=public"
CLIENT_URL="http://localhost:3000"
JWT_SECRET="change-this-to-a-long-random-string"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# Get these from your Cloudinary dashboard: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Get these from your Stripe dashboard: https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY starts with sk_test_... (test mode) or sk_live_...
STRIPE_SECRET_KEY=
# Stripe webhook signing secret. Created under Developers -> Webhooks after you add the /api/v1/payments/webhook endpoint
STRIPE_WEBHOOK_SECRET=

# SMTP transport for transactional email (Nodemailer + Gmail).
# SMTP_PASS must be a Gmail App Password (not your normal account password).
# Generate one at https://myaccount.google.com/apppasswords — requires 2FA.
# NOTE: Gmail SMTP is capped (~500/day regular, ~2000/day Workspace) and is for
# transactional mail only (verification, password reset, booking notifications).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LocalHero <your-account@gmail.com>"
# How long the verification link stays valid (default 30 minutes)
EMAIL_VERIFY_EXPIRES_IN_MINUTES=30

# Credentials for the auto-created Super Admin account (seeded on server start)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
