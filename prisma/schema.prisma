generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                @id @default(uuid())
  name                   String
  email                  String                @unique
  password               String
  role                   Role                  @default(user)
  phone                  String?
  avatar                 String?
  approvalStatus         ApprovalStatus        @default(APPROVED)
  category               String?
  experienceYears        Int?
  serviceDetails         String?
  resetPasswordToken     String?
  resetPasswordExpiresAt DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  emailVerified          Boolean               @default(false)
  verificationToken      String?
  verificationExpiresAt  DateTime?
  bookings               Booking[]             @relation("CustomerBookings")
  conversations          Conversation[]        @relation("CustomerConversations")
  sentMessages           Message[]             @relation("SentMessages")
  notifications          Notification[]
  professional           Professional?
  reviewedApplications   ProviderApplication[] @relation("ReviewedApplications")
  providerApplications   ProviderApplication[] @relation("UserApplications")
  quotes                 Quote[]               @relation("CustomerQuotes")
  favourites             SavedProfessional[]   @relation("FavouriteProfessionals")
  sessions               Session[]
  assignedTickets        SupportTicket[]       @relation("AssignedSupportTickets")
  supportTickets         SupportTicket[]       @relation("UserSupportTickets")
  testimonials           Testimonial[]
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  isActive     Boolean  @default(true)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

model Trade {
  id              String                @id @default(uuid())
  category        String                @unique
  subtitle        String?
  iconName        String
  description     String
  avgHourlyRate   String
  activeProsCount Int                   @default(0)
  popularTasks    String[]
  badge           String?
  featuredService Json?
  sortOrder       Int                   @default(0)
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  bookings        Booking[]
  professions     Profession[]
  professionals   Professional[]
  applications    ProviderApplication[]
  quotes          Quote[]

  @@index([category])
  @@index([isActive])
  @@index([sortOrder])
}

model Profession {
  id            String                @id @default(uuid())
  tradeId       String
  name          String
  description   String?
  isActive      Boolean               @default(true)
  sortOrder     Int                   @default(0)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  bookings      Booking[]
  trade         Trade                 @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  professionals Professional[]
  applications  ProviderApplication[]
  quotes        Quote[]

  @@unique([tradeId, name])
  @@index([tradeId])
  @@index([isActive])
  @@index([sortOrder])
}

model Professional {
  id                   String                @id @default(uuid())
  userId               String?               @unique
  tradeId              String
  professionId         String
  trade                String
  name                 String
  companyName          String
  companyLogo          String?
  avatar               String?
  rating               Float                 @default(0)
  reviewCount          Int                   @default(0)
  jobsCompleted        Int                   @default(0)
  hourlyRate           Int                   @default(0)
  location             String
  postcodeArea         String
  responseMinutes      Int                   @default(30)
  verifiedStatus       Json                  @default("{}")
  bio                  String
  specialties          String[]
  availability         String                @default("Available Today")
  portfolioImages      String[]
  badgeText            String?
  isFeatured           Boolean               @default(false)
  sortOrder            Int                   @default(0)
  workingHours         Json?
  certifications       String[]
  insuranceInfo        String?
  serviceAreas         String[]
  yearsOfExperience    Int?
  isVerified           Boolean               @default(false)
  isEmergency          Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  bookings             Booking[]
  conversations        Conversation[]
  profession           Profession            @relation(fields: [professionId], references: [id])
  tradeRef             Trade                 @relation(fields: [tradeId], references: [id])
  user                 User?                 @relation(fields: [userId], references: [id])
  application          ProviderApplication?
  subscriptions        ProviderSubscription?
  quoteResponses       QuoteResponse[]
  favourites           SavedProfessional[]
  testimonialsReceived Testimonial[]         @relation("ProfessionalTestimonials")

  @@index([trade])
  @@index([tradeId])
  @@index([professionId])
  @@index([tradeId, professionId])
  @@index([postcodeArea])
  @@index([isVerified])
  @@index([isEmergency])
  @@index([isFeatured])
}

model BeforeAfterProject {
  id             String   @id @default(uuid())
  title          String
  trade          String
  location       String
  beforeImage    String?
  afterImage     String?
  description    String
  cost           String
  completionDays String
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([trade])
}

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String
  category  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

model Testimonial {
  id                 String        @id @default(uuid())
  author             String
  role               String        @default("Homeowner")
  city               String
  trade              String
  rating             Int           @default(5)
  date               String
  comment            String
  verifiedJob        String
  avatar             String?
  source             String        @default("PLATFORM")
  sortOrder          Int           @default(0)
  isApproved         Boolean       @default(true)
  isFeatured         Boolean       @default(false)
  photos             String[]
  recommended        Boolean       @default(true)
  businessResponse   String?
  businessResponseAt DateTime?
  bookingId          String?       @unique
  userId             String?
  professionalId     String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  booking            Booking?      @relation(fields: [bookingId], references: [id])
  professional       Professional? @relation("ProfessionalTestimonials", fields: [professionalId], references: [id])
  user               User?         @relation(fields: [userId], references: [id])

  @@index([isApproved, isFeatured])
  @@index([professionalId])
  @@index([userId])
}

model ProviderApplication {
  id              String         @id @default(uuid())
  userId          String
  tradeId         String
  professionId    String
  trade           String
  companyName     String
  companyLogo     String?
  bio             String
  hourlyRate      Int
  location        String
  postcodeArea    String
  specialties     String[]
  experienceYears Int
  phone           String
  avatar          String?
  portfolioImages String[]
  status          ApprovalStatus @default(PENDING)
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?
  professionalId  String?        @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  profession      Profession     @relation(fields: [professionId], references: [id])
  professional    Professional?  @relation(fields: [professionalId], references: [id])
  reviewer        User?          @relation("ReviewedApplications", fields: [reviewedBy], references: [id])
  tradeRef        Trade          @relation(fields: [tradeId], references: [id])
  user            User           @relation("UserApplications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tradeId])
  @@index([professionId])
  @@index([status])
}

model Booking {
  id              String         @id @default(uuid())
  customerId      String
  professionalId  String?
  tradeId         String
  professionId    String
  trade           String
  postcode        String
  address         String
  bookingDate     DateTime
  timeSlot        String
  urgency         String         @default("Standard")
  description     String
  fullName        String
  email           String
  phone           String
  notes           String?
  status          BookingStatus  @default(PENDING)
  priceInPence    Int?
  quoteResponseId String?        @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  customer        User           @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Cascade)
  profession      Profession     @relation(fields: [professionId], references: [id])
  professional    Professional?  @relation(fields: [professionalId], references: [id])
  quoteResponse   QuoteResponse? @relation(fields: [quoteResponseId], references: [id])
  tradeRef        Trade          @relation(fields: [tradeId], references: [id])
  conversations   Conversation[]
  payment         Payment?
  testimonial     Testimonial?

  @@index([customerId])
  @@index([professionalId])
  @@index([tradeId])
  @@index([professionId])
  @@index([tradeId, professionId])
  @@index([status])
  @@index([bookingDate])
}

model Payment {
  id                    String        @id @default(uuid())
  bookingId             String        @unique
  amountInPence         Int
  currency              String        @default("gbp")
  status                PaymentStatus @default(PENDING)
  stripeSessionId       String?       @unique
  stripePaymentIntentId String?
  paidAt                DateTime?
  commissionPence       Int?
  commissionRate        Float?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  booking               Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Quote {
  id            String          @id @default(uuid())
  customerId    String
  tradeId       String
  professionId  String
  trade         String
  postcode      String
  city          String
  description   String
  budgetInPence Int?
  preferredDate DateTime?
  status        QuoteStatus     @default(PENDING)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  conversations Conversation[]
  customer      User            @relation("CustomerQuotes", fields: [customerId], references: [id], onDelete: Cascade)
  profession    Profession      @relation(fields: [professionId], references: [id])
  tradeRef      Trade           @relation(fields: [tradeId], references: [id])
  responses     QuoteResponse[]

  @@index([customerId])
  @@index([trade])
  @@index([tradeId])
  @@index([professionId])
  @@index([tradeId, professionId])
  @@index([status])
}

model QuoteResponse {
  id             String       @id @default(uuid())
  quoteId        String
  professionalId String
  amountInPence  Int
  message        String?
  status         QuoteStatus  @default(PENDING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  booking        Booking?
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  quote          Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, professionalId])
  @@index([professionalId])
  @@index([quoteId])
}

model Conversation {
  id             String       @id @default(uuid())
  customerId     String
  professionalId String
  bookingId      String?
  quoteId        String?
  lastMessageAt  DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  booking        Booking?     @relation(fields: [bookingId], references: [id])
  customer       User         @relation("CustomerConversations", fields: [customerId], references: [id], onDelete: Cascade)
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  quote          Quote?       @relation(fields: [quoteId], references: [id])
  messages       Message[]

  @@index([customerId])
  @@index([professionalId])
  @@index([bookingId])
  @@index([quoteId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  body           String?
  image          String?
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType @default(GENERAL)
  title     String
  body      String?
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model ProviderSubscription {
  id             String             @id @default(uuid())
  professionalId String             @unique
  plan           SubscriptionPlan   @default(FREE)
  status         SubscriptionStatus @default(ACTIVE)
  priceInPence   Int                @default(0)
  startedAt      DateTime           @default(now())
  expiresAt      DateTime?
  isFeatured     Boolean            @default(false)
  featureStartAt DateTime?
  featureEndAt   DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  professional   Professional       @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([plan])
}

model SavedProfessional {
  id             String       @id @default(uuid())
  userId         String
  professionalId String
  createdAt      DateTime     @default(now())
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  user           User         @relation("FavouriteProfessionals", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, professionalId])
  @@index([professionalId])
}

model SupportTicket {
  id         String              @id @default(uuid())
  userId     String
  subject    String
  message    String
  status     SupportTicketStatus @default(OPEN)
  assignedTo String?
  resolvedAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  assignee   User?               @relation("AssignedSupportTickets", fields: [assignedTo], references: [id])
  user       User                @relation("UserSupportTickets", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([assignedTo])
}

enum Role {
  user
  serviceProvider
  ADMIN
  SUPER_ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum QuoteStatus {
  PENDING
  QUOTED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum NotificationType {
  NEW_QUOTE
  QUOTE_RESPONSE
  BOOKING_REQUEST
  BOOKING_CONFIRMATION
  BOOKING_REMINDER
  BOOKING_CANCELLED
  NEW_REVIEW
  NEW_MESSAGE
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  GENERAL
  BOOKING_REJECTED
  BOOKING_IN_PROGRESS
  BOOKING_COMPLETED
  PAYMENT_REFUNDED
  PROVIDER_APPLICATION_SUBMITTED
  PROVIDER_APPLICATION_APPROVED
  PROVIDER_APPLICATION_REJECTED
  LEAD_ACCEPTED
  WELCOME
  ACCOUNT_UPDATED
  ANNOUNCEMENT
  PASSWORD_CHANGED
  REVIEW_REQUESTED
}

enum SubscriptionPlan {
  FREE
  PREMIUM
  FEATURED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}
